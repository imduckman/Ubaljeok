POSTGRES_DB=ubaljeok
POSTGRES_USER=ubaljeok
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://ubaljeok:change-me@db:5432/ubaljeok
REDIS_URL=redis://redis:6379/0
NGINX_PORT=80
RQ_QUEUES=default

# 로그인 세션 (backend/app/core/config.py, 값이 없으면 아래 기본값 사용)
SESSION_COOKIE_NAME=session
SESSION_TTL_DAYS=7
# HTTPS로 공개 배포할 때만 true (로컬 http에서는 false여야 쿠키가 전송됨)
COOKIE_SECURE=false
